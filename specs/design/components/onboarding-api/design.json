  "description": "The single backend for onboarding: plans, plan tasks, the standard template, department task lists and overdue reminders. It owns all records in its PostgreSQL database, copies the template into each new plan, recomputes due dates when a start date changes, works out overdue tasks at read time, and derives a task owner's department from their IT, HR or facilities group. It sends no email or chat messages and holds no UI.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "track-each-hire74-10b95a65",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "onboarding-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "track-each-hire74-24ec6def",
        "envBindings": {
          "dbname": "ONBOARDING_DB_DBNAME",
          "host": "ONBOARDING_DB_HOST",
          "password": "ONBOARDING_DB_PASSWORD",
          "port": "ONBOARDING_DB_PORT",
          "user": "ONBOARDING_DB_USER"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management",
    "database"
  ]
